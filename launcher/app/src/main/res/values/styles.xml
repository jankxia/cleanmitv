<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Settings pages: a translucent window, so the Home wallpaper stays behind the page's glass
         sheet and the pages read as the same material as the top pills. -->
    <style name="Theme.TvHome.Glass" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />

    <!-- Icon-only pill: a 42dp circle (pill_bg's 21dp corners) with the 22dp icon centred by even padding. Give it a
         contentDescription, since there is no text. -->
    <style name="TopButtonIcon" parent="TopButtonBase">
        <item name="android:layout_width">42dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/settings_choice_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="SettingsColumnChoice" parent="SettingsRow">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:gravity">center</item>
        <!-- Tight horizontal padding and a single line keep "100%" from wrapping and clipping. -->
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- A full-width (pulled-across) two-column grid cell: the wrapping column carries the weight,
         this row fills that column and may show a hint underneath. -->
    <style name="SettingsGridCell" parent="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:maxLines">2</item>
    </style>

    <!-- Section header: same-category rows are grouped under one small label. -->
    <style name="SettingsGroupHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:textColor">#FF8FA0AE</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Kids mode: a small choice pill. Selected and focused states come from kids_chip_bg. -->
    <style name="KidsChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/kids_chip_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- Six-hour-limit rows: the six chips have to share one line in a 369dp column, so they drop KidsChip's
         64dp floor and 16dp side padding instead of being squeezed and clipped at the end of the row. -->
    <style name="KidsChipTight" parent="KidsChip">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <!-- Kids mode: the wide action button at the bottom of the rules column. -->
    <style name="KidsButton" parent="KidsChip">
        <item name="android:layout_height">50dp</item>
        <item name="android:minWidth">150dp</item>
        <item name="android:background">@drawable/kids_button_bg</item>
    </style>

    <!-- The schedule grid: one weekday label above each column of half-hour cells. -->
    <style name="SchedDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFACB8C1</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Kids mode: a small chip, for the three settings that share three tight rows. -->
    <style name="KidsChipSmall" parent="KidsChip">
        <item name="android:layout_height">36dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Kids mode: a label on the left and its chips on the right, on one row. -->
    <style name="KidsFieldRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="KidsFieldLabel">
        <item name="android:layout_width">144dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFCBD5DC</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- The quiz's own light surface: a cream button on the warm background. -->
    <style name="KidsButtonCartoon" parent="KidsButton">
        <item name="android:background">@drawable/quiz_back_bg</item>
        <item name="android:textColor">#FF4B3620</item>
        <item name="android:minWidth">170dp</item>
    </style>
</resources>
