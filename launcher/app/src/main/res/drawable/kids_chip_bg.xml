<?xml version="1.0" encoding="utf-8"?>
<!-- Kids/elders choice chips, in the top pills' material: translucent white, one hairline border,
     21dp corners (a 42dp chip, so the same pill as Home). Focused is the pills' focused look. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#66FFFFFF" />
            <corners android:radius="21dp" />
            <stroke android:width="1dp" android:color="#8CFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <corners android:radius="21dp" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
        </shape>
    </item>
</selector>
