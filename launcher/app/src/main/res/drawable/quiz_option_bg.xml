<?xml version="1.0" encoding="utf-8"?>
<!-- A tappable answer: white with a soft outline, warm yellow under the focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFF1CF" />
            <corners android:radius="20dp" />
            <stroke android:width="3dp" android:color="#FFFFA726" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#FFE6C88E" />
        </shape>
    </item>
</selector>
