<?xml version="1.0" encoding="utf-8"?>
<!-- The wide action button (turn the mode off, save, ...): same glass pill as the chips, one step
     larger. Focused is the pills' focused look, near-white with dark text. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="25dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <corners android:radius="25dp" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
        </shape>
    </item>
</selector>
