<?xml version="1.0" encoding="utf-8"?>
<!-- The wide action button: dark row with a green focus ring, as before the settings page went glass. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#5574A987" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFB9E7C7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2E3642" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
