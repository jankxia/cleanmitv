<?xml version="1.0" encoding="utf-8"?>
<!-- The dropdown / settings-menu panel, in the same material as the top pills: translucent, so the
     wallpaper stays behind it, one hairline border and the pills' 21dp corners. The tint is darker
     than the pills so white row text keeps its contrast over a bright wallpaper. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#C41A1D24" android:endColor="#A60C0E14" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
