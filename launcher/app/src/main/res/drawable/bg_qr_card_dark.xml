<?xml version="1.0" encoding="utf-8"?>
<!-- QR card styled to match the dark settings rows instead of a stark white panel. The QR code
     itself keeps its own white square (QrCodeView draws a white background) for reliable scanning. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF1B232C" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="#FF33414F" />
</shape>
