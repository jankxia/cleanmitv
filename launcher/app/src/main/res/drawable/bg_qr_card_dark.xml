<?xml version="1.0" encoding="utf-8"?>
<!-- QR card in the same glass as the settings rows instead of a stark solid panel. The QR code
     itself keeps its own white square (QrCodeView draws a white background) for reliable scanning. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#26FFFFFF" />
    <corners android:radius="21dp" />
    <stroke android:width="1dp" android:color="#3DFFFFFF" />
</shape>
