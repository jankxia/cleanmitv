<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The update URL is always user-configured (Quark/GitHub are HTTPS; self-hosted LAN or
         emulator APK servers may be plain HTTP), so permit cleartext for any host rather than
         maintaining a fragile per-IP whitelist. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
