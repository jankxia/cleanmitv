<?xml version="1.0" encoding="utf-8"?>
<!-- Kids and Elders mode setup, ported from aerial-tv's KidsSetupSheet. Left: the mode's rules.
     Right: every tile the mode can show; picking one puts it at the end of the mode's Home. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_page"
    android:orientation="horizontal"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="34dp"
    android:paddingBottom="30dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/kids_title"
                android:textColor="#FFFFFFFF"
                android:textSize="34sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/kids_hint"
                android:textColor="#FFACB8C1"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/kids_kind"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/kindKids" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="@string/kids_kind_kids" />
                <TextView android:id="@+id/kindElders" style="@style/KidsChip"
                    android:text="@string/kids_kind_elders" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/kids_block"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/blockOff" style="@style/KidsChip"
                    android:text="@string/kids_block_off" />
            </LinearLayout>

            <!-- Without this the lock screen cannot be raised over a video that is already playing. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/overlayButton" style="@style/KidsChip"
                    android:text="@string/kids_overlay_ask" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quizSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/kids_quiz"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <!-- On / off is one chip that says what it is now: "already on" or "not on yet". -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/quizToggle" style="@style/KidsChip"
                    android:text="@string/kids_quiz_gate_off" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/kids_quiz_now_hint"
                android:textColor="#FF7C8891"
                android:textSize="14sp" />

            <!-- Practice, always open: it never asks the limits for a minute. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/quizNowButton" style="@style/KidsButton"
                    android:text="@string/kids_quiz_now" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quizBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/kids_bank"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/stagePrimary" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="@string/kids_stage_primary" />
                    <TextView android:id="@+id/stageMiddle" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="@string/kids_stage_middle" />
                    <TextView android:id="@+id/stageHigh" style="@style/KidsChip"
                        android:text="@string/kids_stage_high" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/kids_stage_note"
                    android:textColor="#FF7C8891"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/kids_grade"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:id="@+id/gradeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/gradeRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/kids_subjects"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:id="@+id/subjectRow1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/subjectRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone" />

                <!-- Pass mark sits right under the subjects, where it belongs with the bank it grades. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/kids_quiz_pass"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/quizPass50" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="50%" />
                    <TextView android:id="@+id/quizPass60" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="60%" />
                    <TextView android:id="@+id/quizPass80" style="@style/KidsChip"
                        android:text="80%" />
                </LinearLayout>

                <!-- The three numbers a round is made of, one label-and-chips row each. -->
                <LinearLayout style="@style/KidsFieldRow">
                    <TextView style="@style/KidsFieldLabel" android:text="@string/kids_quiz_session" />

                    <TextView android:id="@+id/quizMin5" style="@style/KidsChipSmall" android:layout_marginEnd="8dp"
                        android:text="5" />
                    <TextView android:id="@+id/quizMin10" style="@style/KidsChipSmall" android:layout_marginEnd="8dp"
                        android:text="10" />
                    <TextView android:id="@+id/quizMin15" style="@style/KidsChipSmall" android:layout_marginEnd="8dp"
                        android:text="15" />
                    <TextView android:id="@+id/quizMin20" style="@style/KidsChipSmall"
                        android:text="20" />
                </LinearLayout>

                <LinearLayout style="@style/KidsFieldRow">
                    <TextView style="@style/KidsFieldLabel" android:text="@string/kids_quiz_questions" />

                    <TextView android:id="@+id/quizQ3" style="@style/KidsChipSmall" android:layout_marginEnd="8dp"
                        android:text="3" />
                    <TextView android:id="@+id/quizQ5" style="@style/KidsChipSmall" android:layout_marginEnd="8dp"
                        android:text="5" />
                    <TextView android:id="@+id/quizQ8" style="@style/KidsChipSmall"
                        android:text="8" />
                </LinearLayout>

                <LinearLayout style="@style/KidsFieldRow">
                    <TextView style="@style/KidsFieldLabel" android:text="@string/kids_quiz_rounds" />

                    <TextView android:id="@+id/quizRounds1" style="@style/KidsChipSmall" android:layout_marginEnd="8dp"
                        android:text="1" />
                    <TextView android:id="@+id/quizRounds2" style="@style/KidsChipSmall" android:layout_marginEnd="8dp"
                        android:text="2" />
                    <TextView android:id="@+id/quizRounds3" style="@style/KidsChipSmall" android:layout_marginEnd="8dp"
                        android:text="3" />
                    <TextView android:id="@+id/quizRounds5" style="@style/KidsChipSmall"
                        android:text="5" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/kids_quiz_mode"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/modeRound" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="@string/kids_mode_round" />
                    <TextView android:id="@+id/modeStreak" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="@string/kids_mode_streak" />
                    <TextView android:id="@+id/modePractice" style="@style/KidsChip"
                        android:text="@string/kids_mode_practice" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/kids_quiz_extra"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/extraOn" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="@string/st_on" />
                    <TextView android:id="@+id/extraOff" style="@style/KidsChip"
                        android:text="@string/st_off" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/kids_quiz_star"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/starOn" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="@string/st_on" />
                    <TextView android:id="@+id/starOff" style="@style/KidsChip"
                        android:text="@string/st_off" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/kids_quiz_next"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/next0" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="@string/st_off" />
                    <TextView android:id="@+id/next3" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="3s" />
                    <TextView android:id="@+id/next5" style="@style/KidsChip"
                        android:text="5s" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/kids_quiz_schedule"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/scheduleButton" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="@string/kids_quiz_schedule_edit" />
                    <TextView android:id="@+id/holidayOn" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="@string/kids_quiz_holiday" />
                    <TextView android:id="@+id/holidayOff" style="@style/KidsChip"
                        android:text="@string/st_off" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>

            <!-- The watching limits: the elders mode has none of these three. -->
            <LinearLayout
                android:id="@+id/weekdaySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/kids_weekday"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/weekdayNone" style="@style/KidsChipTight" android:layout_marginEnd="10dp"
                        android:text="@string/kids_never" />
                    <TextView android:id="@+id/weekday10" style="@style/KidsChipTight" android:layout_marginEnd="10dp"
                        android:text="10" />
                    <TextView android:id="@+id/weekday30" style="@style/KidsChipTight" android:layout_marginEnd="10dp"
                        android:text="30" />
                    <TextView android:id="@+id/weekday60" style="@style/KidsChipTight" android:layout_marginEnd="10dp"
                        android:text="60" />
                    <TextView android:id="@+id/weekday90" style="@style/KidsChipTight" android:layout_marginEnd="10dp"
                        android:text="90" />
                    <TextView android:id="@+id/weekday120" style="@style/KidsChipTight"
                        android:text="120" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/weekendSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/kids_weekend"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/weekend0" style="@style/KidsChipTight" android:layout_marginEnd="10dp"
                        android:text="@string/kids_no_limit" />
                    <TextView android:id="@+id/weekend10" style="@style/KidsChipTight" android:layout_marginEnd="10dp"
                        android:text="10" />
                    <TextView android:id="@+id/weekend30" style="@style/KidsChipTight" android:layout_marginEnd="10dp"
                        android:text="30" />
                    <TextView android:id="@+id/weekend60" style="@style/KidsChipTight" android:layout_marginEnd="10dp"
                        android:text="60" />
                    <TextView android:id="@+id/weekend90" style="@style/KidsChipTight" android:layout_marginEnd="10dp"
                        android:text="90" />
                    <TextView android:id="@+id/weekend120" style="@style/KidsChipTight"
                        android:text="120" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/latestSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/kids_latest"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/latest0" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="@string/kids_no_limit" />
                    <TextView android:id="@+id/latest20" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="20:00" />
                    <TextView android:id="@+id/latest21" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="21:00" />
                    <TextView android:id="@+id/latest22" style="@style/KidsChip"
                        android:text="22:00" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/breakSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/kids_break"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/break0" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="@string/st_off" />
                    <TextView android:id="@+id/break5" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="5" />
                    <TextView android:id="@+id/break10" style="@style/KidsChip" android:layout_marginEnd="10dp"
                        android:text="10" />
                    <TextView android:id="@+id/break30" style="@style/KidsChip"
                        android:text="30" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/startButton" style="@style/KidsButton"
                    android:text="@string/kids_start_kids" />
                <TextView android:id="@+id/pinButton" style="@style/KidsButton"
                    android:layout_marginStart="12dp"
                    android:text="@string/kids_pin_set" />
            </LinearLayout>

            <!-- Its own row: three buttons do not fit across this column, and the turn-off one used to be squeezed
                 into a sliver that read as an ellipsis. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/turnOffButton" style="@style/KidsButton"
                    android:visibility="gone"
                    android:text="@string/kids_turn_off" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/appsTitle"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:id="@+id/appsHint"
            android:text="@string/kids_apps_hint"
            android:textColor="#FFACB8C1"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>
</LinearLayout>
