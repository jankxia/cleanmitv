<?xml version="1.0" encoding="utf-8"?>
<!-- Kids and Elders mode setup, ported from aerial-tv's KidsSetupSheet. Left: the mode's rules.
     Right: every tile the mode can show; picking one puts it at the end of the mode's Home. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:orientation="horizontal"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="34dp"
    android:paddingBottom="30dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/kids_title"
                android:textColor="#FFFFFFFF"
                android:textSize="34sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/kids_hint"
                android:textColor="#FFACB8C1"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/kids_kind"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/kindKids" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="@string/kids_kind_kids" />
                <TextView android:id="@+id/kindElders" style="@style/KidsChip"
                    android:text="@string/kids_kind_elders" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/kids_block"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/blockOff" style="@style/KidsChip"
                    android:text="@string/kids_block_off" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/kids_weekday"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/weekdayNone" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="@string/kids_never" />
                <TextView android:id="@+id/weekday30" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="30" />
                <TextView android:id="@+id/weekday60" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="60" />
                <TextView android:id="@+id/weekday90" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="90" />
                <TextView android:id="@+id/weekday120" style="@style/KidsChip"
                    android:text="120" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/kids_weekend"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/weekend0" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="@string/kids_no_limit" />
                <TextView android:id="@+id/weekend30" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="30" />
                <TextView android:id="@+id/weekend60" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="60" />
                <TextView android:id="@+id/weekend90" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="90" />
                <TextView android:id="@+id/weekend120" style="@style/KidsChip"
                    android:text="120" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/kids_latest"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/latest0" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="@string/kids_no_limit" />
                <TextView android:id="@+id/latest20" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="20:00" />
                <TextView android:id="@+id/latest21" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="21:00" />
                <TextView android:id="@+id/latest22" style="@style/KidsChip"
                    android:text="22:00" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/kids_break"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/break0" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="@string/st_off" />
                <TextView android:id="@+id/break30" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="30" />
                <TextView android:id="@+id/break45" style="@style/KidsChip" android:layout_marginEnd="10dp"
                    android:text="45" />
                <TextView android:id="@+id/break60" style="@style/KidsChip"
                    android:text="60" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/startButton" style="@style/KidsButton"
                    android:text="@string/kids_start_kids" />
                <TextView android:id="@+id/pinButton" style="@style/KidsButton"
                    android:layout_marginStart="12dp"
                    android:text="@string/kids_pin_set" />
                <TextView android:id="@+id/turnOffButton" style="@style/KidsButton"
                    android:layout_marginStart="12dp"
                    android:visibility="gone"
                    android:text="@string/kids_turn_off" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/appsTitle"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:id="@+id/appsHint"
            android:text="@string/kids_apps_hint"
            android:textColor="#FFACB8C1"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>
</LinearLayout>
