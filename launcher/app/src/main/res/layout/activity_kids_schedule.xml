<?xml version="1.0" encoding="utf-8"?>
<!-- Watching hours, half an hour at a time, Monday to Sunday: green may be watched, grey may not. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_page"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="30dp"
    android:paddingBottom="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@string/font_medium"
        android:text="@string/sched_title"
        android:textColor="#FFFFFFFF"
        android:textSize="30sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/sched_hint"
        android:textColor="#FFACB8C1"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/allOn" style="@style/KidsChip"
            android:layout_marginEnd="10dp" android:text="@string/sched_all_on" />
        <TextView android:id="@+id/allOff" style="@style/KidsChip"
            android:layout_marginEnd="10dp" android:text="@string/sched_all_off" />
        <TextView android:id="@+id/doneButton" style="@style/KidsChip"
            android:text="@string/sched_done" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp" />

        <TextView style="@style/SchedDay" android:text="@string/sched_mon" />
        <TextView style="@style/SchedDay" android:text="@string/sched_tue" />
        <TextView style="@style/SchedDay" android:text="@string/sched_wed" />
        <TextView style="@style/SchedDay" android:text="@string/sched_thu" />
        <TextView style="@style/SchedDay" android:text="@string/sched_fri" />
        <TextView style="@style/SchedDay" android:text="@string/sched_sat" />
        <TextView style="@style/SchedDay" android:text="@string/sched_sun" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
