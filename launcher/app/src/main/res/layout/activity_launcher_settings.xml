<?xml version="1.0" encoding="utf-8"?>
<!-- Home hands its picture to this page, and it goes in this view behind the rows: the glass has
     something to be glass over, and the rows stay readable through the scrim above it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/backdropScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/displayInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="14sp"
            android:textColor="#ACB8C1" />

        <!-- ===== Appearance & layout: three rows on the left, the QR card spans the same height on the right. ===== -->
        <TextView style="@style/SettingsGroupHeader"
            android:layout_marginTop="22dp"
            android:text="@string/group_appearance" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <TextView android:id="@+id/appearanceChoice" style="@style/SettingsGridCell" />
                <TextView android:id="@+id/followThemeChoice" style="@style/SettingsGridCell"
                    android:layout_marginTop="18dp" android:text="@string/follow_theme" />
                <TextView android:id="@+id/weatherCityChoice" style="@style/SettingsGridCell"
                    android:layout_marginTop="18dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qrCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:minHeight="192dp"
                android:background="@drawable/bg_qr_card_dark"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp">

                <com.gathin.tvhome.QrCodeView
                    android:id="@+id/qrCode"
                    android:layout_width="108dp"
                    android:layout_height="108dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/qr_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/qr_hint"
                    android:textColor="#FFACB8C1"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/qrUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FF7FB0FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Dock: opacity and columns on the left, rows below dock on the right. ===== -->
        <TextView style="@style/SettingsGroupHeader" android:text="@string/group_dock" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">
                <TextView android:id="@+id/dockChoice" style="@style/SettingsGridCell" />
                <TextView android:id="@+id/columnsChoice" style="@style/SettingsGridCell"
                    android:layout_marginTop="18dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView android:id="@+id/rowsChoice" style="@style/SettingsGridCell" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Wallpaper & background. ===== -->
        <TextView style="@style/SettingsGroupHeader" android:text="@string/group_wallpaper" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">
                <TextView android:id="@+id/backgroundChoice" style="@style/SettingsGridCell" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView android:id="@+id/wallpaperChoice" style="@style/SettingsGridCell" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Motion effects: animations switch on the left, ambient background motion on the right. ===== -->
        <TextView style="@style/SettingsGroupHeader" android:text="@string/group_effects" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">
                <TextView android:id="@+id/animationsChoice" style="@style/SettingsGridCell" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView android:id="@+id/ambientMotionChoice" style="@style/SettingsGridCell" />
                <TextView
                    android:id="@+id/ambientMotionHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:visibility="gone"
                    android:text="@string/ambient_motion_hint"
                    android:textColor="#FFACB8C1"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== System. ===== -->
        <TextView style="@style/SettingsGroupHeader" android:text="@string/group_system" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">
                <TextView android:id="@+id/defaultHomeChoice" style="@style/SettingsGridCell"
                    android:text="@string/home_settings" />
                <TextView
                    android:id="@+id/defaultHomeHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:visibility="gone"
                    android:text="@string/home_settings_help"
                    android:textColor="#FFACB8C1"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView android:id="@+id/tvSettingsChoice" style="@style/SettingsGridCell"
                    android:text="@string/tv_settings" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Features. ===== -->
        <TextView style="@style/SettingsGroupHeader" android:text="@string/group_features" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">
                <TextView android:id="@+id/kidsChoice" style="@style/SettingsGridCell"
                    android:text="@string/kids_settings" />
                <TextView
                    android:id="@+id/kidsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:visibility="gone"
                    android:text="@string/kids_settings_help"
                    android:textColor="#FFACB8C1"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView android:id="@+id/updateChoice" style="@style/SettingsGridCell"
                    android:text="@string/update_check" />
                <TextView
                    android:id="@+id/updateHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:visibility="gone"
                    android:text="@string/update_hint"
                    android:textColor="#FFACB8C1"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Conditional entries, hidden by default. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/reorderChoice"
                    style="@style/SettingsGridCell"
                    android:text="@string/reorder"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/openOnStartChoice"
                    style="@style/SettingsGridCell"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</FrameLayout>
