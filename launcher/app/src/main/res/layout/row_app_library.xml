<?xml version="1.0" encoding="utf-8"?>
<!-- The footer row spans every column and centres one pill. TopButton's 10dp start margin would leave the pill
     20px right of centre, so it is cleared here. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="84dp">
    <TextView android:id="@+id/btnLibrary" style="@style/TopButton"
        android:layout_gravity="center" android:layout_marginStart="0dp" android:text="@string/app_library"
        android:drawableStart="@drawable/ic_apps_pill" />
</FrameLayout>
