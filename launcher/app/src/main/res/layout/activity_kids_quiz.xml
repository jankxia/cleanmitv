<?xml version="1.0" encoding="utf-8"?>
<!-- The quiz that buys more watching time: one question at a time, four answers, then a result.
     The column is centred in the screen (and scrolls only if a long question still overflows),
     so the last answer card is never cut off by the bottom edge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quiz_bg_cartoon">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="140dp"
            android:paddingEnd="140dp"
            android:paddingTop="30dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/backButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:background="@drawable/quiz_back_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/quiz_back"
                    android:textColor="#FF4B3620"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FF8A7355"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="26dp"
                    android:textColor="#FFE08A00"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="26dp"
                    android:textColor="#FF8A7355"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/quiz_card"
                android:fontFamily="@string/font_medium"
                android:lineSpacingExtra="3dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:textColor="#FF3D2C17"
                android:textSize="25sp" />

            <LinearLayout
                android:id="@+id/options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#FF9A6A28"
                android:textSize="23sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Where a star flies in: drawn over the column, so it never changes its height. -->
    <TextView
        android:id="@+id/starPop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="150dp"
        android:text="⭐"
        android:textSize="64sp"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/resultPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7FFF8E8"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="60dp"
        android:paddingEnd="60dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/quiz_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"
            android:paddingTop="34dp"
            android:paddingBottom="34dp">

            <TextView
                android:id="@+id/resultIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="62sp" />

            <TextView
                android:id="@+id/resultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@string/font_medium"
                android:gravity="center"
                android:textColor="#FF3D2C17"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/resultSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="#FF8A7355"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/againButton"
                    style="@style/KidsButtonCartoon"
                    android:text="@string/quiz_again" />

                <TextView
                    android:id="@+id/closeButton"
                    style="@style/KidsButtonCartoon"
                    android:layout_marginStart="14dp"
                    android:text="@string/quiz_close" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
